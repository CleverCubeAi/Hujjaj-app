# ===========================================
# Hujjaj Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database (Docker Compose Postgres)
POSTGRES_USER=hujjaj
POSTGRES_PASSWORD=hujjaj
POSTGRES_DB=hujjaj
POSTGRES_PORT=5432
DATABASE_URL=postgres://hujjaj:hujjaj@postgres:5432/hujjaj

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Super admin (created on Docker/backend start if none exists)
SUPER_ADMIN_EMAIL=admin@hujjaj.app
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_NAME=Super Admin

# Full Al-Baraka demo seed (runs by default on Docker start; set to false to skip)
SEED_DEMO=true
DEMO_PASSWORD=Demo123!

# Backend
PORT=3001
NODE_ENV=production
PUBLIC_URL=http://localhost:3001

# Frontend (browser calls API; use full URL for local Vite, /api behind nginx)
VITE_API_URL=http://localhost:3001/api

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
