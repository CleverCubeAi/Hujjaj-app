# ===========================================
# Hujjaj Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database (Docker Compose Postgres)
POSTGRES_USER=hujjaj
POSTGRES_PASSWORD=hujjaj
POSTGRES_DB=hujjaj
POSTGRES_PORT=5432
DATABASE_URL=postgres://hujjaj:hujjaj@postgres:5432/hujjaj

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7

# AES-256 key for SMTP/Twilio secrets (32+ characters)
ENCRYPTION_KEY=replace-with-a-random-32-char-secret!!

# Optional separate HMAC key for signed upload URLs (falls back to ENCRYPTION_KEY)
# UPLOAD_SIGNING_KEY=replace-with-another-random-32-char-secret

# CORS (comma-separated). Required when the API is on a different origin.
CORS_ORIGIN=http://localhost:5173,http://localhost,http://127.0.0.1

# Public agency self-registration (keep false in production)
ALLOW_PUBLIC_REGISTER=false

# Super admin (created on Docker/backend start if none exists)
SUPER_ADMIN_EMAIL=admin@hujjaj.app
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_NAME=Super Admin

# Full Al-Baraka demo seed (runs by default on Docker start; set to false to skip)
SEED_DEMO=true
DEMO_PASSWORD=Demo123!

# Public site URL (the frontend origin). Used for cookies (Secure if https) and signed upload links.
PUBLIC_URL=http://localhost

# Frontend (browser calls API; use /api behind nginx so cookies stay same-origin)
VITE_API_URL=/api

# Railway frontend service: private URL of the backend (no trailing slash)
# BACKEND_UPSTREAM=http://backend.railway.internal:3001

# Railway: never seed demo data
# SEED_DEMO=false
# COOKIE_SECURE=true
# ALLOW_PUBLIC_REGISTER=false

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
