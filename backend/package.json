{
  "name": "hujjaj-backend",
  "version": "1.0.0",
  "description": "Hujjaj Hajj & Omra SaaS Backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed:super-admin": "ts-node src/scripts/seedSuperAdmin.ts",
    "seed:super-admin:prod": "node dist/scripts/seedSuperAdmin.js",
    "seed:demo": "ts-node src/scripts/seedDemo.ts",
    "seed:demo:prod": "node dist/scripts/seedDemo.js",
    "seed": "npm run seed:super-admin && npm run seed:demo",
    "seed:prod": "npm run seed:super-admin:prod && npm run seed:demo:prod",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "hajj",
    "omra",
    "saas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "twilio": "^5.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.4",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
